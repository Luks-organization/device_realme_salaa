allow system_suspend sysfs_wakeup:dir r_dir_perms;
allow system_suspend sysfs_wakeup:file rw_file_perms;
allow system_suspend sysfs_wakeup:lnk_file r_file_perms;
allow system_suspend sysfs_power:dir r_dir_perms;
allow system_suspend sysfs_type:dir r_dir_perms; 
allow system_suspend block_device:dir search;
allow system_suspend same_process_hal_file:file { read open map getattr execute };
dontaudit system_suspend sysfs:file { open read getattr };
